{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2021",
    "lib": [
      "ES2021"
    ],
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "rootDirs": [
      "./src",
      "../shared"
    ],
    "strict": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@shared/*": [
        "../shared/*"
      ],
      "@server/*": [
        "../server/*"
      ]
    }
  },
  "include": [
    "src/**/*",
    "../shared/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}